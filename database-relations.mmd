erDiagram
  User ||--o{ Student : "studentProfile (embedded reference)"
  User ||--o{ Faculty : "staffProfile (embedded reference)"
  User ||--o{ DepartmentStaff : "staffProfile (embedded reference)"
  User ||--o{ AdminStaff : "staffProfile (embedded reference)"
  User ||--o{ Admin : "adminProfile (embedded reference)"
  User ||--o{ Assignment : "createdBy ref"
  User ||--o{ AttendanceRecord : "user ref"
  User ||--o{ AuditLog : "actor ref"
  User ||--o{ FeeServiceRequest : "requestedBy / reviewedBy ref"
  User ||--o{ Invoice : "generatedBy ref"
  User ||--o{ KnowledgeDocument : "uploadedBy ref"
  User ||--o{ KnowledgeChunk : "uploadedBy ref"
  User ||--o{ Notification : "recipient ref"
  User ||--o{ Payment : "receivedBy ref"
  User ||--o{ StudentFee : "createdBy / updatedBy ref"
  User ||--o{ SystemSetting : "updatedBy ref"
  User ||--o{ PortalData : "updatedBy ref"
  User ||--o{ FeeStructure : "changedBy ref (in amountHistory)"
  User ||--o{ Receipt : "printedBy ref (in reprintHistory)"
  Student ||--o{ Assignment : "student ref"
  Student ||--o{ GradeRecord : "student ref"
  Student ||--o{ AttendanceRecord : "student ref"
  Student ||--o{ StudentFee : "student ref"
  Student ||--o{ Invoice : "student ref"
  Student ||--o{ Payment : "student ref"
  Student ||--o{ Receipt : "student ref"
  Student ||--o{ Refund : "student ref"
  Student ||--o{ Contact : "student ref"
  Student ||--o{ FeeServiceRequest : "student ref"
  Student ||--o{ Notification : "student ref"
  Course ||--o{ Student : "course ref"
  Course ||--o{ Application : "course ref"
  Course ||--o{ FeeStructure : "courseId ref"
  Course ||--o{ StudentFee : "courseId ref"
  TimetableEntry ||--o{ AttendanceRecord : "timetableEntry ref"
  FeeCategory ||--o{ FeeStructure : "category ref"
  FeeCategory ||--o{ StudentFee : "category ref"
  FeeStructure ||--o{ StudentFee : "feeStructure ref"
  Semester ||--o{ FeeStructure : "semesterId ref"
  Invoice ||--o{ Payment : "invoice ref"
  StudentFee ||--o{ FeeServiceRequest : "feeRecord ref"
  StudentFee ||--o{ Payment : "feeRecord ref"
  StudentFee ||--o{ Invoice : "feeRecord ref (in lines)"
  Payment ||--o{ Receipt : "payment ref"
  Payment ||--o{ Refund : "payment ref"
  Faculty ||--o{ DepartmentStaff : "faculty ref"
  Faculty ||--o{ AdminStaff : "faculty ref"
  KnowledgeDocument ||--o{ KnowledgeChunk : "document ref"

  User {
    ObjectId _id PK
    string name "required"
    string email UK "required, lowercase"
    string passwordHash "required"
    boolean mustChangePassword "default: false"
    string role "enum: student|lecturer|admin|finance_officer|department_staff"
    string accountStatus "enum: pending|approved|rejected, default: pending"
    object studentProfile "embedded: studentId,nic,department,program,intake,academicYear,academicStage,studyMode,phone,guardianName,guardianPhone,profilePhotoUrl"
    object staffProfile "embedded: staffId,department,staffType,phone,office,bio,profilePhotoUrl"
    object adminProfile "embedded: staffId,designation,department,phone,office,profilePhotoUrl"
    date createdAt
    date updatedAt
  }

  Student {
    ObjectId _id PK
    string fullName "required"
    string email "required"
    string phone
    string nic
    string studentId
    string department
    string program
    string intake
    string academicYear
    string academicStage "enum: First year Full Time|Second year Full Time|First year Part Time|Second year Part Time"
    string studyMode "enum: Full-time|Part-time"
    string guardianName
    string guardianPhone
    ObjectId course FK "ref -> Course"
    string paymentStatus "enum: not_required|pending|paid|partial, default: pending"
    date createdAt
    date updatedAt
  }

  Faculty {
    ObjectId _id PK
    string fullName "required"
    string email UK "required, lowercase"
    string phone
    string department
    string staffType "default: Teaching Staff"
    string status "enum: Active|On Leave|Inactive, default: Active"
    number coursesAssigned "default: 0, min: 0"
    number rating "default: 4.5, min: 0, max: 5"
    date joinDate
    string office
    string bio
    date createdAt
    date updatedAt
  }

  Department {
    ObjectId _id PK
    string name "required"
    string imageUrl
    string description "required"
    date createdAt
    date updatedAt
  }

  Course {
    ObjectId _id PK
    string title "required"
    string duration "required"
    string entryRequirements "required"
    string fee "default: Contact office"
    string department
    string description
    string instructor
    number progress "default: 0, min: 0, max: 100"
    array modules "embedded: [{title, lessons[], quizzes[], assignments[]}]"
    date createdAt
    date updatedAt
  }

  DepartmentStaff {
    ObjectId _id PK
    ObjectId faculty FK "ref -> Faculty, unique, sparse"
    string fullName "required"
    string email UK "required, lowercase"
    string phone
    string department "required"
    string staffType "enum: Teaching Staff|Head of the department, default: Teaching Staff"
    string status "enum: Active|On Leave|Inactive, default: Active"
    number coursesAssigned "default: 0, min: 0"
    date joinDate
    string office
    string bio
    date createdAt
    date updatedAt
  }

  Admin {
    ObjectId _id PK
    string name "required"
    string email UK "required, lowercase"
    array permissions "[string]"
    date createdAt
    date updatedAt
  }

  AdminStaff {
    ObjectId _id PK
    ObjectId faculty FK "ref -> Faculty, unique, sparse"
    string fullName "required"
    string email UK "required, lowercase"
    string phone
    string staffType "enum: Administrative Staff|Director, default: Administrative Staff"
    string status "enum: Active|On Leave|Inactive, default: Active"
    date joinDate
    string office
    string bio
    date createdAt
    date updatedAt
  }

  TimetableEntry {
    ObjectId _id PK
    string department "required"
    string academicStage "enum: First year Full Time|Second year Full Time|First year Part Time|Second year Part Time"
    string day "required, enum: Monday|Tuesday|Wednesday|Thursday|Friday"
    string time "required"
    string subject "required"
    string lecturer
    string room
    date createdAt
    date updatedAt
  }

  AttendanceRecord {
    ObjectId _id PK
    ObjectId student FK "ref -> Student, required"
    ObjectId user FK "ref -> User, required"
    ObjectId timetableEntry FK "ref -> TimetableEntry, required"
    string studentName "required"
    string studentId
    string department "required"
    string academicStage
    string subject "required"
    string lecturer
    string room
    string date "required"
    string day "required"
    string time "required"
    string status "enum: present, default: present"
    string method "enum: GPS, default: GPS"
    date markedAt "default: now"
    number latitude "required"
    number longitude "required"
    number accuracy
    number distanceMeters
    date createdAt
    date updatedAt
  }

  Assignment {
    ObjectId _id PK
    string title "required"
    string subject "required"
    string topicModule
    string description
    string department "required"
    string academicStage "enum: First year Full Time|..."
    ObjectId student FK "ref -> Student"
    string studentName
    string studentId
    date dueDate "required"
    number totalMarks "default: 100, min: 0"
    string status "enum: draft|published|closed, default: published"
    date publishAt
    string visibility "enum: department|group|student, default: department"
    boolean notifyByEmail "default: false"
    string attachmentUrl
    array attachments "embedded: [{name,url,type,mimeType,size,addedAt}]"
    array materials "embedded: [{name,url,type,mimeType,size,addedAt}]"
    array announcements "embedded: [{author(User),authorName,student(Student),message,visibility,createdAt}]"
    array comments "embedded: [{author(User),authorName,student(Student),message,visibility,createdAt}]"
    array submissions "embedded: [{student(Student),studentName,studentId,files,googleDocLinks,note,status,marks,rubric,feedback,privateFeedback,submittedAt,gradedAt}]"
    ObjectId createdBy FK "ref -> User"
    date createdAt
    date updatedAt
  }

  GradeRecord {
    ObjectId _id PK
    ObjectId student FK "ref -> Student, required"
    string studentName "required"
    string studentId
    string department "required"
    string academicStage
    string subject "required"
    number semester "required, min: 1"
    number credits "required, min: 0"
    number score "required, min: 0, max: 100"
    string grade "required, enum: A+|A|A-|B+|B|B-|C+|C|C-|D+|D|F"
    string remarks
    date createdAt
    date updatedAt
  }

  Application {
    ObjectId _id PK
    string fullName "required"
    string email "required"
    string phone "required"
    string nic "required"
    ObjectId course FK "ref -> Course"
    array documentUrls "[string]"
    string status "enum: pending|reviewing|approved|rejected, default: pending"
    date createdAt
    date updatedAt
  }

  FeeCategory {
    ObjectId _id PK
    string name "required, enum: Registration Fee|Course Fee|Examination Fee|Library Fee|Certificate Fee"
    string code UK "required, uppercase"
    string description
    boolean isActive "default: true"
    date createdAt
    date updatedAt
  }

  Semester {
    ObjectId _id PK
    string name "required"
    string code UK "required"
    string academicYear "required"
    date startDate
    date endDate
    string status "enum: planned|active|completed, default: planned"
    date createdAt
    date updatedAt
  }

  FeeStructure {
    ObjectId _id PK
    string name "required"
    ObjectId category FK "ref -> FeeCategory, required"
    string departmentId "required"
    string departmentName
    ObjectId courseId FK "ref -> Course"
    string courseName
    ObjectId semesterId FK "ref -> Semester"
    string semesterName "required"
    string academicYear "required"
    number amount "required, min: 0"
    string currency "default: LKR"
    number dueDays "default: 30, min: 0"
    string lateFeeType "enum: none|fixed|percentage, default: fixed"
    number lateFeeValue "default: 0, min: 0"
    boolean isActive "default: true"
    array amountHistory "embedded: [{amount,changedBy(User),changedAt,reason}]"
    date createdAt
    date updatedAt
  }

  StudentFee {
    ObjectId _id PK
    ObjectId student FK "ref -> Student, required"
    string studentId "required"
    string studentName "required"
    string departmentId "required"
    string departmentName
    ObjectId courseId FK "ref -> Course"
    string courseName
    string semesterName "required"
    string academicYear "required"
    ObjectId feeStructure FK "ref -> FeeStructure"
    ObjectId category FK "ref -> FeeCategory"
    string description
    number totalAmount "required, min: 0"
    number paidAmount "default: 0, min: 0"
    number discountAmount "default: 0, min: 0"
    number lateFeeAmount "default: 0, min: 0"
    date dueDate "required"
    string status "enum: pending|partial|paid|overdue|cancelled, default: pending"
    array installmentPlan "embedded: [{label,amount,dueDate,status(pending|paid|overdue)}]"
    string notes
    ObjectId createdBy FK "ref -> User"
    ObjectId updatedBy FK "ref -> User"
    date createdAt
    date updatedAt
  }

  Invoice {
    ObjectId _id PK
    string invoiceNumber UK "required"
    ObjectId student FK "ref -> Student, required"
    string studentId "required"
    string studentName "required"
    string departmentId "required"
    string semesterName
    string academicYear
    date issueDate "default: now"
    date dueDate "required"
    number subtotal "required, min: 0"
    number lateFeeAmount "default: 0, min: 0"
    number discountAmount "default: 0, min: 0"
    number totalAmount "required, min: 0"
    number paidAmount "default: 0, min: 0"
    string status "enum: unpaid|partial|paid|void, default: unpaid"
    array lines "embedded: [{description,amount,feeRecord(StudentFee)}]"
    ObjectId generatedBy FK "ref -> User"
    date createdAt
    date updatedAt
  }

  Payment {
    ObjectId _id PK
    string paymentNumber UK "required"
    ObjectId student FK "ref -> Student, required"
    string studentId "required"
    string studentName "required"
    string departmentId "required"
    ObjectId feeRecord FK "ref -> StudentFee"
    ObjectId invoice FK "ref -> Invoice"
    number amount "required, min: 1"
    string method "required, enum: Cash|Card|Credit/Debit Card|Bank Transfer|Internet Banking|Mobile Wallet|UPI/QR Payment|Online Payment|PayHere|Stripe|PayPal"
    string transactionReference
    date paymentDate "default: now"
    string status "enum: pending|validated|failed|refunded, default: validated"
    ObjectId receivedBy FK "ref -> User"
    array transactionLogs "embedded: [{status,message,metadata,createdAt}]"
    date createdAt
    date updatedAt
  }

  Receipt {
    ObjectId _id PK
    string receiptNumber UK "required"
    ObjectId payment FK "ref -> Payment, required"
    ObjectId student FK "ref -> Student, required"
    string studentId "required"
    string studentName "required"
    string departmentId "required"
    number amount "required, min: 0"
    date issuedAt "default: now"
    string qrVerificationCode UK "required"
    array reprintHistory "embedded: [{printedBy(User),printedAt,reason}]"
    date createdAt
    date updatedAt
  }

  Refund {
    ObjectId _id PK
    string refundNumber UK "required"
    ObjectId payment FK "ref -> Payment, required"
    ObjectId student FK "ref -> Student, required"
    string studentId "required"
    string studentName "required"
    string departmentId "required"
    number amount "required, min: 1"
    string reason "required"
    string status "enum: requested|approved|rejected|paid, default: requested"
    ObjectId requestedBy FK "ref -> User"
    ObjectId reviewedBy FK "ref -> User"
    date reviewedAt
    string reviewNote
    array auditTrail "embedded: [{action,by(User),at,note}]"
    date createdAt
    date updatedAt
  }

  FeeServiceRequest {
    ObjectId _id PK
    string requestNumber UK "required"
    string type "required, enum: bank_slip_upload|installment_plan|fee_extension|statement_download|fee_policy|no_due_certificate|fee_waiver|scholarship|discount"
    string title "required"
    ObjectId student FK "ref -> Student, required"
    string studentId "required"
    string studentName "required"
    string departmentId "required"
    ObjectId feeRecord FK "ref -> StudentFee"
    number amount "min: 0"
    string note
    string attachmentUrl
    string status "enum: requested|approved|rejected|completed, default: requested"
    ObjectId requestedBy FK "ref -> User"
    ObjectId reviewedBy FK "ref -> User"
    date reviewedAt
    string reviewNote
    array history "embedded: [{action,by(User),at,note}]"
    date createdAt
    date updatedAt
  }

  Notification {
    ObjectId _id PK
    ObjectId recipient FK "ref -> User"
    ObjectId student FK "ref -> Student"
    string departmentId
    string type "required, enum: fee_due_reminder|payment_confirmation|refund_notification|overdue_alert"
    string channel "enum: in_app|email|sms, default: in_app"
    string title "required"
    string message "required"
    string status "enum: queued|sent|failed|read, default: queued"
    date sentAt
    object metadata
    date createdAt
    date updatedAt
  }

  Contact {
    ObjectId _id PK
    string name "required"
    string email "required"
    string subject "required"
    string message "required"
    string type "enum: contact|complaint, default: contact"
    string audience "enum: admin|department, default: admin"
    string department
    ObjectId student FK "ref -> Student"
    string studentName
    string studentId
    string status "enum: new|read|resolved|archived, default: new"
    string priority "enum: low|normal|high|urgent, default: normal"
    string category "enum: general|fees|academic|technical, default: general"
    string assignedTo
    string internalNote
    date repliedAt
    date createdAt
    date updatedAt
  }

  Blog {
    ObjectId _id PK
    string title "required"
    string slug UK "auto-generated"
    string excerpt "required"
    string content "required"
    string imageUrl
    string author "default: ATI Jaffna Admin"
    boolean published "default: true"
    date createdAt
    date updatedAt
  }

  Event {
    ObjectId _id PK
    string title "required"
    date date "required"
    string imageUrl
    string description "required"
    date createdAt
    date updatedAt
  }

  Notice {
    ObjectId _id PK
    string title "required"
    string body "required"
    string audience "enum: all|students|lecturers|admins, default: all"
    date createdAt
    date updatedAt
  }

  PageContent {
    ObjectId _id PK
    string slug UK "required, lowercase"
    string title "required"
    string status "enum: draft|published|unpublished, default: draft"
    object draft "embedded: {heroTitle,heroDescription,heroImageUrl,primaryButtonText,primaryButtonLink,secondaryButtonText,secondaryButtonLink,seoTitle,seoDescription,sections[]}"
    object published "embedded: same structure as draft"
    date publishedAt
    date createdAt
    date updatedAt
  }

  KnowledgeDocument {
    ObjectId _id PK
    string title "required"
    string originalName
    string department "required"
    string topicModule
    string fileType "required, enum: pdf|docx|pptx|txt"
    string fileUrl
    string status "enum: indexing|indexed|failed, default: indexing"
    string error
    number chunkCount "default: 0"
    string visibility "enum: department|private, default: department"
    ObjectId uploadedBy FK "ref -> User"
    string uploadedByName
    date createdAt
    date updatedAt
  }

  KnowledgeChunk {
    ObjectId _id PK
    ObjectId document FK "ref -> KnowledgeDocument, required"
    string department "required"
    string topicModule
    number chunkIndex "required"
    string text "required"
    array tokens "[string]"
    map vector "Map of Number"
    string visibility "enum: department|private, default: department"
    ObjectId uploadedBy FK "ref -> User"
    date createdAt
    date updatedAt
  }

  AuditLog {
    ObjectId _id PK
    ObjectId actor FK "ref -> User"
    string actorRole
    string action "required"
    string entityType "required"
    ObjectId entityId
    string departmentId
    object before
    object after
    string ipAddress
    string userAgent
    date createdAt
    date updatedAt
  }

  PortalData {
    ObjectId _id PK
    string key UK "required"
    mixed value "default: {}"
    ObjectId updatedBy FK "ref -> User"
    date createdAt
    date updatedAt
  }

  SystemSetting {
    ObjectId _id PK
    string key UK "required"
    mixed value "default: {}"
    ObjectId updatedBy FK "ref -> User"
    date createdAt
    date updatedAt
  }
