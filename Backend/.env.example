# ============================================================================
# ATI Jaffna Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# === SERVER ===
PORT=5000
NODE_ENV=development                                    # development | production | test
TRUST_PROXY=false                                       # Set true if behind nginx/load balancer
MAX_JSON_BODY=10mb                                      # Maximum JSON body size
LOG_LEVEL=                                              # trace | debug | info | warn | error (defaults: debug/dev, info/prod)

# === DATABASE ===
MONGODB_URI=mongodb://127.0.0.1:27017/ATI_JAFFNA
AUTO_START_MONGO=true                                   # Auto-start local MongoDB if not running
MONGODB_DATA_PATH=                                      # Custom MongoDB data directory
MONGODB_LOG_PATH=                                       # Custom MongoDB log file path
MONGO_MAX_POOL_SIZE=10                                  # Max connections in MongoDB pool
MONGO_MIN_POOL_SIZE=2                                   # Min connections in MongoDB pool

# === AUTHENTICATION ===
JWT_SECRET=replace-this-secret-with-a-minimum-32-char-string  # REQUIRED: At least 32 chars in production
JWT_EXPIRES_IN=1d                                       # Token expiry (e.g., 1d, 8h, 7d)
BCRYPT_ROUNDS=10                                        # Salt rounds for password hashing

# === CORS ===
CLIENT_URL=http://127.0.0.1:5173                        # Frontend URL for CORS
CORS_ORIGINS=                                           # Comma-separated additional allowed origins

# === DEFAULT ADMIN SEEDING ===
SEED_DEFAULT_ADMIN=true                                 # Auto-create default admin on first run
DEFAULT_ADMIN_EMAIL=admin@atijaffna.edu.lk
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME=ATI Jaffna Admin

# === GROQ AI (OPTIONAL) ===
AI_PROVIDER=nvidia                                      # nvidia | groq (NVIDIA/Gemma is preferred when configured)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_COMPLETION_TOKENS=1200

# === NVIDIA GEMMA AI (OPTIONAL) ===
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_ENABLE_THINKING=true

# === GPS ATTENDANCE ===
ATI_CAMPUS_LAT=9.651841
ATI_CAMPUS_LNG=80.023445
ATTENDANCE_RADIUS_METERS=500
